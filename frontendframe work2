<!DOCTYPE html>
<html>
<head>
  <title>My Landing Page</title>
  <!-- Materialize CSS CDN -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/materialize/1.0.0/css/materialize.min.css">
</head>
<body>

  <!-- Navigation Bar -->
  <nav class="blue">
    <div class="nav-wrapper">
      <a href="#" class="brand-logo">My Logo</a>
      <ul class="right">
        <li><a href="#">Home</a></li>
        <li><a href="#">About</a></li>
      </ul>
    </div>
  </nav>

  <div class="container">
    <h1>Welcome to My Page</h1>
    <p>This is my landing page made with Materialize.</p>

    <!-- 2 Buttons -->
    <a class="btn">Button 1</a>
    <a class="btn red">Button 2</a>

    <h2>My Data Table</h2>

    <!-- Table -->
    <table class="responsive-table">
      <thead>
        <tr>
          <th>Name</th>
          <th>Age</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td>Alex</td>
          <td>25</td>
        </tr>
        <tr>
          <td>Sam</td>
          <td>30</td>
        </tr>
      </tbody>
    </table>
  </div>

</body>
</html>
